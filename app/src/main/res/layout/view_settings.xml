<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="10dp"
    android:paddingBottom="4dp">

    <!-- 行1：字号 + 系统字体 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:orientation="horizontal"
        android:layout_marginBottom="9dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_card"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <TextView
                android:id="@+id/fontMinus"
                android:layout_width="34dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="A"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#333333" />

            <LinearLayout
                android:id="@+id/fontNums"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center" />

            <TextView
                android:id="@+id/fontPlus"
                android:layout_width="34dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="A"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#333333" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navFont"
            android:layout_width="96dp"
            android:layout_height="match_parent"
            android:layout_marginStart="9dp"
            android:background="@drawable/bg_card"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="10dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="系统字体"
                android:textSize="13sp"
                android:textColor="#333333" />

            <ImageView
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:alpha="0.55"
                android:src="@drawable/ic_chevron"
                android:scaleType="fitCenter" />
        </LinearLayout>
    </LinearLayout>

    <!-- 行2：主题 + 背景 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:orientation="horizontal"
        android:layout_marginBottom="9dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_card"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="6dp"
            android:paddingEnd="6dp">

            <LinearLayout
                android:id="@+id/themeDots"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navBg"
            android:layout_width="96dp"
            android:layout_height="match_parent"
            android:layout_marginStart="9dp"
            android:background="@drawable/bg_card"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="10dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="背景"
                android:textSize="13sp"
                android:textColor="#333333" />

            <ImageView
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:alpha="0.55"
                android:src="@drawable/ic_chevron"
                android:scaleType="fitCenter" />
        </LinearLayout>
    </LinearLayout>

    <!-- 行3：翻页方式 + 间距 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:orientation="horizontal"
        android:layout_marginBottom="9dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_card"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <LinearLayout
                android:id="@+id/pageModes"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navSpacing"
            android:layout_width="96dp"
            android:layout_height="match_parent"
            android:layout_marginStart="9dp"
            android:background="@drawable/bg_card"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="10dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="间距"
                android:textSize="13sp"
                android:textColor="#333333" />

            <ImageView
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:alpha="0.55"
                android:src="@drawable/ic_chevron"
                android:scaleType="fitCenter" />
        </LinearLayout>
    </LinearLayout>

    <!-- 行4：自动阅读 + 更多设置 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/cardAuto"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_card"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp">

            <ImageView
                android:id="@+id/autoPlayIcon"
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:src="@drawable/ic_play"
                android:scaleType="fitCenter" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="开启自动阅读"
                android:textSize="13.5sp"
                android:textColor="#333333" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/cardMore"
            android:layout_width="96dp"
            android:layout_height="match_parent"
            android:layout_marginStart="9dp"
            android:background="@drawable/bg_card"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="10dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="更多设置"
                android:textSize="13sp"
                android:textColor="#333333" />

            <ImageView
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:alpha="0.55"
                android:src="@drawable/ic_chevron"
                android:scaleType="fitCenter" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
