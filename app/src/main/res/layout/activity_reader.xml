<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F2F2F2">

    <!-- 正文视口 -->
    <FrameLayout
        android:id="@+id/viewport"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.quark.reader.ScrollReaderView
            android:id="@+id/scrollReader"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <com.quark.reader.PagedView
            android:id="@+id/pagedReader"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />
    </FrameLayout>

    <!-- 顶栏（右侧原功能替换为查找关键词按钮） -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="4dp"
        android:paddingEnd="8dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_back"
            android:scaleType="centerInside"
            android:contentDescription="@string/catalog" />

        <TextView
            android:id="@+id/topTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="2dp"
            android:singleLine="true"
            android:ellipsize="end"
            android:textSize="14sp"
            android:textColor="#8C8C8C" />

        <ImageButton
            android:id="@+id/btnSearchText"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_search"
            android:scaleType="centerInside"
            android:contentDescription="查找关键词" />
    </LinearLayout>

    <!-- 记事本式查找关键词浮层栏（只有查找输入和跳转下一个，无替换） -->
    <LinearLayout
        android:id="@+id/findBar"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_gravity="top"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="8dp"
        android:elevation="12dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/findIcon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_search"
            android:scaleType="fitCenter" />

        <EditText
            android:id="@+id/etFindKeyword"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:singleLine="true"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:hint="查找内容…"
            android:textSize="14sp"
            android:background="@drawable/bg_pill" />

        <TextView
            android:id="@+id/btnFindNext"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:gravity="center"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="查找下一个"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_btn_primary" />

        <ImageButton
            android:id="@+id/btnFindClose"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_close"
            android:scaleType="centerInside"
            android:contentDescription="关闭查找" />
    </LinearLayout>

    <!-- 底部信息条 -->
    <LinearLayout
        android:id="@+id/bottomInfo"
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvClock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textColor="#9A9A9A" />

            <com.quark.reader.BatteryIcon
                android:id="@+id/batteryIcon"
                android:layout_width="20dp"
                android:layout_height="11dp"
                android:layout_marginStart="6dp" />
        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tvProgress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textColor="#9A9A9A"
            android:text="0.0%" />
    </LinearLayout>

    <!-- 目录抽屉 -->
    <View
        android:id="@+id/drawerMask"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#6B000000"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/drawer"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#FFFFFF"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingTop="20dp"
            android:paddingBottom="10dp">

            <TextView
                android:id="@+id/cover"
                android:layout_width="46dp"
                android:layout_height="64dp"
                android:background="@drawable/bg_cover"
                android:gravity="center"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold"
                android:maxLines="6"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/drawerTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#1F1F1F"
                android:maxLines="2"
                android:ellipsize="end"
                android:lineSpacingMultiplier="1.15" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/sortPill"
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:layout_marginStart="18dp"
            android:layout_marginEnd="18dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="6dp"
            android:background="@drawable/bg_pill"
            android:orientation="horizontal"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="本地书籍"
                android:textSize="12sp"
                android:textColor="#888888" />

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginStart="6dp"
                android:src="@drawable/ic_sort"
                android:scaleType="fitCenter" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/chapterList"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingBottom="24dp"
            android:clipToPadding="false" />
    </LinearLayout>

    <!-- 底部菜单 -->
    <LinearLayout
        android:id="@+id/bottomUi"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="#F7F7F7"
        android:elevation="10dp"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/chapNav"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="11dp"
            android:paddingBottom="11dp">

            <TextView
                android:id="@+id/btnPrevChap"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="6dp"
                android:text="@string/prev_chapter"
                android:textSize="15sp"
                android:textColor="#333333" />

            <com.quark.reader.PillBar
                android:id="@+id/pill"
                android:layout_width="0dp"
                android:layout_height="30dp"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp" />

            <TextView
                android:id="@+id/btnNextChap"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="6dp"
                android:text="@string/next_chapter"
                android:textSize="15sp"
                android:textColor="#333333" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/settingsPanelWrap"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone">

            <include layout="@layout/view_settings" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/iconbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="6dp"
            android:paddingBottom="10dp">

            <LinearLayout
                android:id="@+id/btnCatalog"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="?attr/selectableItemBackground">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_list"
                    android:scaleType="fitCenter" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/catalog"
                    android:textSize="11sp"
                    android:textColor="#555555" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnNight"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="?attr/selectableItemBackground">

                <ImageView
                    android:id="@+id/nightIcon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_moon"
                    android:scaleType="fitCenter" />

                <TextView
                    android:id="@+id/nightLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/night"
                    android:textSize="11sp"
                    android:textColor="#555555" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnSettings"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="?attr/selectableItemBackground">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_gear"
                    android:scaleType="fitCenter" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/settings"
                    android:textSize="11sp"
                    android:textColor="#555555" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- 更多设置 -->
    <View
        android:id="@+id/moreMask"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#6B000000"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/moreSheet"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="bottom"
        android:layout_marginTop="80dp"
        android:orientation="vertical"
        android:background="@drawable/bg_sheet"
        android:elevation="12dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="8dp">

            <ImageButton
                android:id="@+id/moreBack"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_back"
                android:scaleType="centerInside"
                android:contentDescription="back" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/more_settings"
                android:textSize="16.5sp"
                android:textStyle="bold"
                android:textColor="#1F1F1F" />
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:overScrollMode="never">

            <LinearLayout
                android:id="@+id/moreBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingBottom="30dp" />
        </ScrollView>
    </LinearLayout>

    <!-- 子设置面板 -->
    <View
        android:id="@+id/subMask"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#6B000000"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/subSheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:minHeight="320dp"
        android:orientation="vertical"
        android:background="@drawable/bg_sheet"
        android:elevation="14dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="8dp">

            <ImageButton
                android:id="@+id/subBack"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_back"
                android:scaleType="centerInside"
                android:contentDescription="back" />

            <TextView
                android:id="@+id/subTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="16.5sp"
                android:textStyle="bold"
                android:textColor="#1F1F1F" />
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxHeight="420dp"
            android:overScrollMode="never">

            <LinearLayout
                android:id="@+id/subBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingBottom="30dp" />
        </ScrollView>
    </LinearLayout>

    <!-- 自动阅读 HUD -->
    <LinearLayout
        android:id="@+id/autoHud"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="120dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_hud"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="9dp"
        android:paddingBottom="9dp"
        android:visibility="gone">

        <ImageButton android:id="@+id/autoPause" style="@style/HudBtn" android:src="@drawable/ic_pause" android:contentDescription="pause" />
        <ImageButton android:id="@+id/autoUp" style="@style/HudBtn" android:src="@drawable/ic_up" android:contentDescription="up" />
        <TextView
            android:id="@+id/autoSpeed"
            android:layout_width="44dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="1.0x"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#FFC53D" />
        <ImageButton android:id="@+id/autoDown" style="@style/HudBtn" android:src="@drawable/ic_down" android:contentDescription="down" />
        <ImageButton android:id="@+id/autoClose" style="@style/HudBtn" android:src="@drawable/ic_close" android:contentDescription="close" />
    </LinearLayout>
</FrameLayout>
